# LGU Smart Convocation — environment template (Phase 16)
#
# PLACEHOLDERS ONLY. Never put real credentials in this file; `.env` is
# git-ignored and this template is committed on purpose.
#
# This application reads configuration from the PROCESS ENVIRONMENT only —
# there is no .env loader in the codebase. Copy the names you need into your
# shell, service unit, or hosting platform's secret configuration:
#
#   PowerShell:  $env:LGU_SMTP_HOST = "smtp.example.edu.pk"
#   Linux:       export LGU_SMTP_HOST=smtp.example.edu.pk
#
# Full reference: docs/EMAIL_CONFIGURATION.md
# Validate before use:  cd app && ..\.venv\Scripts\python.exe scripts\check_email_config.py check

# --- Email delivery (verification codes + password recovery) -------------
# disabled = fail closed with HTTP 503 (default). smtp = real provider.
# fake = test-only outbox, refused outside LGU_TESTING=1 or on the prod DB.
LGU_EMAIL_MODE=disabled
LGU_SMTP_HOST=
LGU_SMTP_PORT=587
# auto | starttls | ssl | none   (auto = STARTTLS only when a username is set)
LGU_SMTP_TLS=auto
LGU_SMTP_TIMEOUT=10
LGU_SMTP_USER=
# App password / SMTP secret — supply from the secret store, never here.
LGU_SMTP_PASSWORD=
# Sender address; required when LGU_SMTP_USER is empty.
LGU_MAIL_FROM=
LGU_VERIFICATION_TTL=600
LGU_CODE_MAX_SENDS=3
LGU_CODE_MAX_ATTEMPTS=5

# --- Student API rate limits (per client IP, window in seconds) ----------
LGU_STUDENT_WINDOW=60
LGU_STUDENT_MAX_VERIFY=6
LGU_STUDENT_MAX_RECOVERY=3
LGU_STUDENT_MAX_LOGIN=5
LGU_STUDENT_MAX_CONFIRM=20

# --- Core app secrets (replace before any real deployment) ---------------
LGU_SECRET_KEY=change-me
LGU_HMAC_SECRET=change-me
LGU_ADMIN_PIN=
