# Prevent local files, secrets, student data, backups or APKs entering
# Docker build contexts (even when they are not tracked by git).
.git/
.github/
.env
.env.*
**/.env
**/.env.*
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/venv/
**/node_modules/
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.wal
**/*.shm
**/backups/
**/data/
**/evidence/
**/screenshots/
**/*.csv
**/*.xlsx
**/*.xls
**/*.log
**/*.zip
**/*.bak
**/*.dump
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.apk
**/*.aab
mobile/
docs/
